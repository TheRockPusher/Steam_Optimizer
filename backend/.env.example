APP=Steam Optimizer API
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000
STEAM_WEB_API_KEY=
STEAMAPI_KEY=
SIGNING_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GEM_PRICE_CACHE_PATH=.cache/steam-optimizer/gem_prices.sqlite3
STEAMAPIS_PRICE_CACHE_PATH=.cache/steam-optimizer/steamapis_prices.sqlite3
# Leave these monetary values blank until the provider currency, buyer-total basis, fee rules,
# and top-of-book depth have been independently verified; any partial group fails closed.
# LEVEL_UP_PRICE_BASIS accepts only buyer_total.
LEVEL_UP_CURRENCY_CODE=
LEVEL_UP_CURRENCY_MINOR_DIGITS=
LEVEL_UP_PRICE_BASIS=
LEVEL_UP_STEAM_FEE_BPS=
LEVEL_UP_PUBLISHER_FEE_BPS=
LEVEL_UP_MIN_FEE_MINOR=
LEVEL_UP_MAX_QUOTE_AGE_SECONDS=900
LEVEL_UP_MAX_INVENTORY_AGE_SECONDS=3600
